# Flint 后端环境变量样例(复制成 .env 后按需修改;.env 不要进版本库)
# 已接入 @nestjs/config:.env.local / .env 会在启动时自动加载,
# shell 里显式设置的变量优先级最高(便于临时覆盖)。

# ---- 服务 ----
PORT=3000

# ---- 产物交付 ----
# 存储类型:fs(单机开发,默认) | s3(AWS S3 / 阿里云 OSS / MinIO)
FLINT_ARTIFACT_STORE=fs
# 产物目录(fs 适配器,单机开发用;生产接对象存储后替换适配器)
FLINT_ARTIFACT_DIR=./output/artifacts
# ---- S3 / OSS / MinIO(FLINT_ARTIFACT_STORE=s3 时必填)----
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com   # MinIO 可填 http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=flint-artifacts
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true
# FLINT_ARTIFACT_S3_PREFIX=flint-artifacts
# 落盘总开关:设为 0 后只能 inline 交付
# FLINT_ARTIFACT_WRITE=0
# 签名 URL / 产物保留期(秒),默认 7 天
FLINT_ARTIFACT_TTL_SECONDS=604800
# 默认交付模式:inline | url | both(生产建议 url)
FLINT_ARTIFACT_DELIVERY=url
# 对外 HTTPS 域名(反向代理/容器部署时必填,用于拼绝对产物 URL)
FLINT_PUBLIC_BASE_URL=https://flint.example.com
# 鉴权:MCP 端点要求 Authorization: Bearer <token>;
# 产物 URL 用同一 token 做 HMAC 签名,浏览器可直接打开
FLINT_MCP_AUTH_TOKEN=change-me
# 单个产物大小上限(字节),默认 16MiB
FLINT_ARTIFACT_MAX_BYTES=16777216
