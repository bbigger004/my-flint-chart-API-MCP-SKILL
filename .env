# 本地开发配置:@nestjs/config 会自动加载本文件(.env.local 优先级更高)
# 该文件已被 .gitignore 排除,请勿把真实密钥提交进仓库

PORT=3000

# ---- 产物交付 ----
FLINT_ARTIFACT_STORE=fs
FLINT_ARTIFACT_DIR=./output/artifacts
FLINT_ARTIFACT_DELIVERY=url
FLINT_ARTIFACT_TTL_SECONDS=604800
FLINT_ARTIFACT_MAX_BYTES=16777216

# 对外域名(反向代理/隧道部署时打开)
# FLINT_PUBLIC_BASE_URL=https://flint.example.com

# 鉴权 + 产物 URL HMAC 签名(打开后 /mcp 必须带 Authorization: Bearer <token>)
# FLINT_MCP_AUTH_TOKEN=change-me

# ---- 对象存储(FLINT_ARTIFACT_STORE=s3 时必填)----
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_REGION=us-east-1
# S3_BUCKET=flint-artifacts
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true
# FLINT_ARTIFACT_S3_PREFIX=flint-artifacts
